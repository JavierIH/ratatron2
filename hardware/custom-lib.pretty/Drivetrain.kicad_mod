(footprint "Drivetrain"
	(version 20241229)
	(generator "pcbnew")
	(generator_version "9.0")
	(layer "F.Cu")
	(descr "3D view only: what was visible in Javier's FreeCAD model (chassis, motors, wheels, axles, bearings, battery), exported to mechanics/drivetrain.step. No pads. Place it at the grid origin (centre of the outline), rotation 0, on F.Cu: the offset (0 -12 0) undoes the +12 mm in Y between KiCad and FreeCAD (notes/tools/pcb_step.py). Typed SMD and kept in the position files only so that the 3D viewer shows it by default (it hides unspecified and not-in-POS models)")
	(tags "mechanics 3d drivetrain")
	(property "Reference" "MECH1"
		(at 0 0 0)
		(layer "F.Fab")
		(hide yes)
